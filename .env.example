# ---------------------------------------------------------------- core
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_DB=sqlite
# used only when DJANGO_DB=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/shop2
SITE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------- payments
PAYMENT_GATEWAY=apps.payments.gateways.MockGateway
# PAYMENT_GATEWAY=apps.payments.gateways.ZarinPalGateway
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ZARINPAL_SANDBOX=True
# production refuses MockGateway unless this is set (staging only)
# ALLOW_MOCK_GATEWAY=False

# ---------------------------------------------------------------- SMS (phone login + order texts)
# development default writes messages to sent_sms/
# SMS_BACKEND=apps.common.sms.SmsIrBackend
# SMSIR_API_KEY=
# SMSIR_OTP_TEMPLATE_ID=123456        # Verify template containing the #CODE# parameter
# SMSIR_OTP_PARAMETER=CODE
# SMSIR_LINE_NUMBER=30007732000000    # only for order status texts
# ALLOW_FAKE_SMS=False                # production refuses the file backend unless set (staging only)
# OTP_TTL_SECONDS=120
# OTP_RESEND_SECONDS=60

# ---------------------------------------------------------------- orders
# managers alerted when an order is paid (comma-separated; emails default to ADMIN_EMAIL)
# ORDER_NOTIFY_PHONES=09120000000,09350000000
# ORDER_NOTIFY_EMAILS=orders@shop.example.com
# ADMIN_EMAIL=admin@shop.example.com
# RETURN_WINDOW_DAYS=7
# ORDER_PAYMENT_TIMEOUT_MINUTES=30
# ORDER_PAYMENT_GRACE_MINUTES=15

# ---------------------------------------------------------------- rate limiting
# RATELIMIT_ENABLE=True
# RATELIMIT_IP_HEADER=HTTP_X_REAL_IP

# ---------------------------------------------------------------- production only
# (DJANGO_SETTINGS_MODULE=config.settings.prod must be set in the process environment)
# DJANGO_SECRET_KEY=<50+ random characters>
# DJANGO_ALLOWED_HOSTS=shop.example.com,www.shop.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=2592000
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@shop.example.com
# CACHE_URL=rediscache://127.0.0.1:6379/1
# SENTRY_DSN=
