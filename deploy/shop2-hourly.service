# /etc/systemd/system/shop2-hourly.service — run by shop2-hourly.timer
[Unit]
Description=shop2: abandoned-cart reminders and price-drop alerts
After=network.target postgresql.service

[Service]
Type=oneshot
User=shop2
WorkingDirectory=/srv/shop2
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
EnvironmentFile=/srv/shop2/.env
ExecStart=/srv/shop2/.venv/bin/python manage.py remind_abandoned_carts
ExecStart=/srv/shop2/.venv/bin/python manage.py send_price_alerts
ExecStart=/srv/shop2/.venv/bin/python manage.py request_reviews
